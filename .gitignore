# Secrets & Environment (JANGAN PERNAH DI-PUSH)
.env
# Backup .env ikut memuat token/API key — jangan sampai ikut ke-track
.env.*
!.env.example
*.session
*.session-journal
*.key
*.pem

# Databases & Data Files
*.db
*.sqlite
*.sqlite3
# File pendamping SQLite WAL — jangan pernah masuk repo (isinya data live)
*.db-wal
*.db-shm
*.db-journal

# Logs
logs/
*.log

# Python cache, venv & Tests
myenv/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# OS / Temporary
.DS_Store
*.tmp
hoodsniper.db.bak*
hoodsniper.db.archive-*
# Snapshot dari tools/backup_db.py
backups/
